@page
@* Exercício: 9 *@
@model CityBreaks.Web.Pages.CreatePropertyModel
@{
    ViewData["Title"] = "Nova propriedade";
}

<h1>Nova propriedade</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Property.Name" class="form-label"></label>
        <input asp-for="Property.Name" class="form-control" />
        <span asp-validation-for="Property.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Property.PricePerNight" class="form-label"></label>
        <input asp-for="Property.PricePerNight" class="form-control" />
        <span asp-validation-for="Property.PricePerNight" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Property.CityId" class="form-label"></label>
        <select asp-for="Property.CityId" asp-items="Model.Cities" class="form-select"></select>
        <span asp-validation-for="Property.CityId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-page="/Index">Cancelar</a>
</form>
